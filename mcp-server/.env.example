# ─────────────────────────────────────────────────────────────────────────────
# LLM PROVIDERS  (comma-separated key pools — all are optional except at least 1)
# Fallback order: Gemini -> GitHub Models -> Cerebras -> Groq -> SambaNova -> OpenRouter
# ─────────────────────────────────────────────────────────────────────────────

# 1. Google AI Studio — Gemini 2.5 Flash (BEST free quality, 250K TPM)
#    Get key: https://aistudio.google.com/apikey
GEMINI_API_KEYS=gemini_key_1,gemini_key_2
GEMINI_API_KEY=

# 2. GitHub Models — GPT-4.1 / GPT-4o (frontier quality, FREE with GitHub account)
#    Generate token: https://github.com/settings/tokens  (no scopes needed)
GITHUB_TOKENS=ghp_your_token_here
GITHUB_TOKEN=

# 3. Cerebras — Qwen3-32B / Llama-3.3-70B (ultra fast inference, 1M tokens/day free)
#    Get key: https://cloud.cerebras.ai
CEREBRAS_API_KEYS=cerebras_key_1
CEREBRAS_API_KEY=

# 4. Groq — Llama-3.3-70B (fast LPU, 1K req/day free on 70B)
#    Get key: https://console.groq.com
GROQ_API_KEYS=groq_key_1,groq_key_2
GROQ_API_KEY=

# 5. SambaNova — Llama-3.3-70B / Qwen2.5-72B (persistent free tier)
#    Get key: https://cloud.sambanova.ai
SAMBANOVA_API_KEYS=sambanova_key_1
SAMBANOVA_API_KEY=

# 6. OpenRouter — Qwen3-235B / DeepSeek R1 (last resort, 50 req/day free)
#    Get key: https://openrouter.ai/keys
OPENROUTER_API_KEYS=or_key_1,or_key_2
OPENROUTER_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# JOB SEARCH
# ─────────────────────────────────────────────────────────────────────────────
# JSearch API — real LinkedIn/Indeed/Glassdoor data
# Sign up: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=your_jsearch_rapidapi_key

# ─────────────────────────────────────────────────────────────────────────────
# WHATSAPP / COMPOSIO
# ─────────────────────────────────────────────────────────────────────────────
COMPOSIO_API_KEY=your_composio_key
